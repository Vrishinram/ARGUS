# Gateway Server Configuration
ARGUS_ENV=development
ARGUS_HOST=0.0.0.0
ARGUS_PORT=8000
ARGUS_DEBUG=true

# Security & Authentication
# Comma-separated list of valid client API keys
ARGUS_API_KEYS=sk-argus-test-client-key-1,sk-argus-admin-master-key
ARGUS_ADMIN_API_KEY=sk-argus-admin-master-key

# Rate Limiting
ARGUS_RATE_LIMIT_ENABLED=true
ARGUS_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Upstream LLM Configuration
# Options: mock, openai, gemini, anthropic, custom
ARGUS_UPSTREAM_PROVIDER=mock
ARGUS_UPSTREAM_BASE_URL=https://api.openai.com/v1
ARGUS_UPSTREAM_API_KEY=
ARGUS_UPSTREAM_MODEL=gpt-4o-mini
ARGUS_UPSTREAM_TIMEOUT_SECONDS=30.0

# Storage & Logging
ARGUS_DB_PATH=argus_gateway.db
ARGUS_POLICY_PATH=policies/default_policy.yaml
